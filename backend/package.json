{
  "name": "financy-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ./src/generated --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
